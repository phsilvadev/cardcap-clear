rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tenantDomains/{slug} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && slug.matches('^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$')
        && !(slug in ['www', 'admin', 'api', 'app', 'mail', 'suporte', 'parceiro'])
        && request.resource.data.keys().hasAll(['tenantId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['tenantId', 'createdAt'])
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/tenants/$(request.auth.uid)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/tenants/$(request.auth.uid)).data.slug == slug;
      allow list, update, delete: if false;
    }

    // Um usuário pode criar somente o próprio tenant, com ID igual ao UID do Firebase Auth.
    match /tenants/{tenantId} {
      allow get: if request.auth != null && request.auth.uid == tenantId;
      allow list: if false;

      allow update: if request.auth != null
        && request.auth.uid == tenantId
        && resource.data.ownerUid == request.auth.uid
        && !('slug' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slug', 'updatedAt'])
        && request.resource.data.slug is string
        && request.resource.data.slug.matches('^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$')
        && !(request.resource.data.slug in ['www', 'admin', 'api', 'app', 'mail', 'suporte', 'parceiro'])
        && getAfter(/databases/$(database)/documents/tenantDomains/$(request.resource.data.slug)).data.tenantId == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow create: if request.auth != null
        && request.auth.uid == tenantId
        && request.resource.data.keys().hasAll([
          'ownerUid', 'ownerName', 'name', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerName', 'name', 'status', 'createdAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 3
        && request.resource.data.ownerName.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null
        && request.auth.uid == tenantId
        && resource.data.ownerUid == tenantId
        && resource.data.status == 'pending'
        && request.resource.data.keys().hasAll([
          'ownerUid', 'ownerName', 'name', 'status', 'createdAt',
          'legalName', 'cnpj', 'phone', 'whatsapp', 'contactEmail',
          'category', 'description', 'postalCode', 'street', 'number',
          'complement', 'district', 'city', 'state', 'openingTime',
          'closingTime', 'openingDay', 'closingDay', 'acceptsDelivery', 'acceptsPickup', 'asaasWalletId', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerName', 'name', 'status', 'createdAt', 'slug',
          'legalName', 'cnpj', 'phone', 'whatsapp', 'contactEmail',
          'category', 'description', 'postalCode', 'street', 'number',
          'complement', 'district', 'city', 'state', 'openingTime',
          'closingTime', 'openingDay', 'closingDay', 'acceptsDelivery', 'acceptsPickup', 'asaasWalletId', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerName', 'name', 'status', 'legalName', 'cnpj', 'phone', 'whatsapp', 'contactEmail',
          'category', 'description', 'postalCode', 'street', 'number',
          'complement', 'district', 'city', 'state', 'openingTime',
          'closingTime', 'openingDay', 'closingDay', 'acceptsDelivery', 'acceptsPickup', 'asaasWalletId', 'updatedAt'
        ])
        && request.resource.data.status == 'configured'
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 3
        && request.resource.data.ownerName.size() <= 100
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 80
        && request.resource.data.legalName is string
        && (request.resource.data.legalName == '' || request.resource.data.legalName.size() >= 3)
        && request.resource.data.legalName.size() <= 120
        && request.resource.data.cnpj is string
        && (request.resource.data.cnpj == '' || request.resource.data.cnpj.matches('^[0-9]{14}$'))
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{10,11}$')
        && request.resource.data.whatsapp is string
        && (request.resource.data.whatsapp == '' || request.resource.data.whatsapp.matches('^[0-9]{10,11}$'))
        && request.resource.data.contactEmail is string
        && request.resource.data.contactEmail.size() <= 254
        && request.resource.data.contactEmail.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.category in [
          'restaurante', 'lanchonete', 'pizzaria', 'cafeteria',
          'padaria', 'doceria', 'mercado', 'outros'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 20
        && request.resource.data.description.size() <= 300
        && request.resource.data.postalCode is string
        && request.resource.data.postalCode.matches('^[0-9]{8}$')
        && request.resource.data.street is string
        && request.resource.data.street.size() >= 3
        && request.resource.data.street.size() <= 120
        && request.resource.data.number is string
        && request.resource.data.number.size() >= 1
        && request.resource.data.number.size() <= 12
        && request.resource.data.complement is string
        && request.resource.data.complement.size() <= 100
        && request.resource.data.district is string
        && request.resource.data.district.size() >= 2
        && request.resource.data.district.size() <= 60
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 60
        && request.resource.data.state is string
        && request.resource.data.state in [
          'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES', 'GO', 'MA',
          'MT', 'MS', 'MG', 'PA', 'PB', 'PR', 'PE', 'PI', 'RJ', 'RN',
          'RS', 'RO', 'RR', 'SC', 'SP', 'SE', 'TO'
        ]
        && request.resource.data.openingDay in [
          'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado', 'Domingo'
        ]
        && request.resource.data.closingDay in [
          'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado', 'Domingo'
        ]
        && request.resource.data.openingTime is string
        && request.resource.data.openingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.closingTime is string
        && request.resource.data.closingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.openingTime != request.resource.data.closingTime
        && request.resource.data.acceptsDelivery is bool
        && request.resource.data.acceptsPickup is bool
        && (request.resource.data.acceptsDelivery || request.resource.data.acceptsPickup)
        && request.resource.data.asaasWalletId is string
        && request.resource.data.asaasWalletId.matches('^[a-zA-Z0-9_-]{10,100}$')
        && request.resource.data.updatedAt == request.time;

      // Carteira informada pelo proprietário; não confirma titularidade no Asaas
      // nem concede permissão para ativar vendas ou alterar repasses em operação.
      allow update: if request.auth != null
        && request.auth.uid == tenantId
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'configured'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'asaasWalletId', 'updatedAt'
        ])
        && request.resource.data.asaasWalletId is string
        && request.resource.data.asaasWalletId.matches('^[a-zA-Z0-9_-]{10,100}$')
        && request.resource.data.updatedAt == request.time;

      // Concluir a preparação libera a interface de gestão, sem ativar vendas.
      allow update: if request.auth != null
        && request.auth.uid == tenantId
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'configured'
        && resource.data.asaasWalletId is string
        && resource.data.asaasWalletId.matches('^[a-zA-Z0-9_-]{10,100}$')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['setupCompleted', 'updatedAt'])
        && request.resource.data.setupCompleted == true
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;

      match /products/{productId} {
        function validOption(option, minimumPrice) {
          let name = option.name;
          let price = option.priceCents;
          return option.keys().hasOnly(['name', 'priceCents'])
            && name is string && name.matches('^.{2,60}$') && name.matches('.*[^[:space:]].*')
            && price is int && price >= minimumPrice && price <= 99999999;
        }

        // Lists are bounded so every stored option is validated by the rules.
        function validOptions(options, minimumPrice) {
          let count = options.size();
          return options is list && count >= 1 && count <= 10
            && validOption(options[0], minimumPrice)
            && (count == 1 || (validOption(options[1], minimumPrice) && (count == 2 || (validOption(options[2], minimumPrice) && (count == 3 || (validOption(options[3], minimumPrice) && (count == 4 || (validOption(options[4], minimumPrice) && (count == 5 || (validOption(options[5], minimumPrice) && (count == 6 || (validOption(options[6], minimumPrice) && (count == 7 || (validOption(options[7], minimumPrice) && (count == 8 || (validOption(options[8], minimumPrice) && (count == 9 || validOption(options[9], minimumPrice))))))))))))))))));
        }

        function validComplementGroup(group) {
          let name = group.name;
          let minimum = group.min;
          let maximum = group.max;
          let options = group.options;
          return group.keys().hasOnly(['name', 'min', 'max', 'repeat', 'options'])
            && name is string && name.matches('^.{2,60}$') && name.matches('.*[^[:space:]].*')
            && minimum is int && maximum is int
            && minimum >= 0 && maximum >= 1 && minimum <= maximum && maximum <= 20
            && group.repeat is bool
            && validOptions(options, 0)
            && (group.repeat || maximum <= options.size());
        }

        function validDivision(division) {
          return division == null || (division is map
            && division.keys().hasOnly(['maxParts', 'pricing', 'options'])
            && division.maxParts is int && division.maxParts >= 2 && division.maxParts <= 8
            && division.pricing in ['fixed', 'highest', 'proportional']
            && validOptions(division.options, division.pricing == 'fixed' ? 0 : 1)
            && division.options.size() >= 2);
        }

        function groupOptionCount(groups, index) {
          return groups.size() > index ? groups[index].options.size() : 0;
        }

        function validCustomization(config) {
          let groups = config.groups;
          let division = config.division;
          let count = groups.size();
          return config.keys().hasOnly(['groups', 'division'])
            && groups is list && count <= 5
            && groupOptionCount(groups, 0) + groupOptionCount(groups, 1)
              + groupOptionCount(groups, 2) + groupOptionCount(groups, 3)
              + groupOptionCount(groups, 4)
              + (division == null ? 0 : division.options.size()) <= 20
            && (count < 1 || validComplementGroup(groups[0]))
            && (count < 2 || validComplementGroup(groups[1]))
            && (count < 3 || validComplementGroup(groups[2]))
            && (count < 4 || validComplementGroup(groups[3]))
            && (count < 5 || validComplementGroup(groups[4]))
            && validDivision(division);
        }

        function isProductOwner() {
          return request.auth != null
            && request.auth.uid == tenantId
            && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
        }

        allow get: if isProductOwner();
        allow list: if isProductOwner() && request.query.limit != null && request.query.limit <= 50;
        allow create, update: if isProductOwner()
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status in ['configured', 'active']
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.asaasWalletId is string
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.asaasWalletId.matches('^[a-zA-Z0-9_-]{10,100}$')
          && request.resource.data.keys().hasAll(['storeId', 'name', 'description', 'categoryId', 'priceCents', 'available', 'imagePath', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['storeId', 'name', 'description', 'categoryId', 'priceCents', 'available', 'imagePath', 'createdAt', 'updatedAt', 'customization'])
          && (!('customization' in request.resource.data) || validCustomization(request.resource.data.customization))
          && request.resource.data.imagePath == 'tenants/' + tenantId + '/products/' + productId + '/image'
          && request.resource.data.storeId == tenantId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 100
          && request.resource.data.name.matches('.*[^[:space:]].*')
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() > 0
          && request.resource.data.categoryId.size() <= 1500
          && !request.resource.data.categoryId.matches('.*/.*')
          && get(/databases/$(database)/documents/tenants/$(tenantId)/categories/$(request.resource.data.categoryId)).data.storeId == tenantId
          && request.resource.data.priceCents is int
          && request.resource.data.priceCents >= 1
          && request.resource.data.priceCents <= 99999999
          && request.resource.data.available is bool
          && ((resource == null && request.resource.data.createdAt == request.time)
            || (resource != null && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'categoryId', 'priceCents', 'available', 'customization', 'imagePath', 'updatedAt'])))
          && request.resource.data.updatedAt == request.time;
        allow delete: if isProductOwner()
          && resource.data.storeId == tenantId
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status in ['configured', 'active']
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.asaasWalletId is string
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.asaasWalletId.matches('^[a-zA-Z0-9_-]{10,100}$');
      }

      match /categories/{categoryId} {
        function isOwner() {
          return request.auth != null
            && request.auth.uid == tenantId
            && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
        }

        allow get: if isOwner();
        allow list: if isOwner() && request.query.limit != null && request.query.limit <= 50;

        allow create: if isOwner()
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.status in ['configured', 'active']
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.asaasWalletId is string
          && get(/databases/$(database)/documents/tenants/$(tenantId)).data.asaasWalletId.matches('^[a-zA-Z0-9_-]{10,100}$')
          && request.resource.data.keys().hasAll(['storeId', 'name', 'description', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['storeId', 'name', 'description', 'createdAt', 'updatedAt'])
          && request.resource.data.storeId == tenantId
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 60
          && request.resource.data.name.matches('.*[^[:space:]].*')
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 200
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update, delete: if false;
      }

      match /employees/{employeeId} {
        function isStoreOwner() {
          return request.auth != null
            && request.auth.uid == tenantId
            && get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerUid == request.auth.uid;
        }

        function storeIsOperational() {
          return get(/databases/$(database)/documents/tenants/$(tenantId)).data.status in ['configured', 'active'];
        }

        function validEmployeeFields(data) {
          return data.name is string
            && data.name.size() >= 3
            && data.name.size() <= 100
            && data.email is string
            && data.email.size() >= 5
            && data.email.size() <= 254
            && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
            && data.role in ['attendant', 'manager']
            && data.active is bool
            && data.storeId == tenantId;
        }

        allow get: if isStoreOwner();
        allow list: if isStoreOwner()
          && request.query.limit != null
          && request.query.limit <= 50;

        allow create: if isStoreOwner()
          && storeIsOperational()
          && request.resource.data.keys().hasAll(['storeId', 'name', 'email', 'role', 'active', 'createdAt'])
          && request.resource.data.keys().hasOnly(['storeId', 'name', 'email', 'role', 'active', 'createdAt'])
          && validEmployeeFields(request.resource.data)
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time;

        allow update: if isStoreOwner()
          && storeIsOperational()
          && resource.data.storeId == tenantId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'updatedAt'])
          && request.resource.data.active is bool
          && request.resource.data.updatedAt == request.time;

        allow delete: if isStoreOwner()
          && storeIsOperational()
          && resource.data.storeId == tenantId;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
