# Use sandbox para homologação. Não coloque chaves de API ou tokens neste arquivo.
ASAAS_ENVIRONMENT=sandbox
# Ative somente depois de configurar App Check, segredos, carteira e webhook.
CHECKOUT_PIX_ENABLED=false

# URL HTTPS do servidor Evolution API, sem credenciais. A chave vai no Secret Manager.
EVOLUTION_API_URL=
# URL pública da Function evolutionWhatsAppWebhook (opcional se usar o endereço padrão).
EVOLUTION_WEBHOOK_URL=
