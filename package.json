{
  "name": "cardap-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "playwright test",
    "test:security:live": "node --env-file=.env.local scripts/test-firebase-isolation.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:menu:rules": "firebase emulators:exec --project demo-cardap-test --config firebase.emulators.json --only auth,firestore,storage \"playwright test --config playwright.rules.config.ts\"",
    "desktop:install": "npm --prefix desktop/printing install",
    "desktop:start": "npm --prefix desktop/printing start",
    "desktop:pack": "npm --prefix desktop/printing run pack"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
