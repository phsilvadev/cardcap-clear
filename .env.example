# Configuração pública do aplicativo web no Firebase.
# Use os mesmos valores do projeto anow/main em .env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Origem HTTPS do domínio central em produção (sem barra final).
AUTH_APP_ORIGIN=

# Domínio base para subdomínios das lojas em produção (ex.: cardap.com.br).
AUTH_TENANT_DOMAIN=

# Ative após publicar tenantLoginTransfer e autorizar sua conta de serviço a assinar tokens.
AUTH_TENANT_SUBDOMAIN_LOGIN=false

# ID de 11 caracteres de um vídeo do YouTube sobre obter o Wallet ID (opcional).
NEXT_PUBLIC_ASAAS_WALLET_VIDEO_ID=

# Links HTTPS de instalação dos aplicativos (opcionais; ficam ocultos até serem definidos).
CARDAP_WAITER_APP_URL=
CARDAP_COURIER_APP_URL=
CARDAP_PRINT_APP_URL=

# WhatsApp de suporte da plataforma, com código do país e DDD.
CARDAP_SUPPORT_WHATSAPP=5586995747604

# reCAPTCHA via Firebase App Check. Registre a chave no App Check antes de ativar.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
NEXT_PUBLIC_FIREBASE_APPCHECK_PROVIDER=enterprise
# Somente desenvolvimento em localhost; não é uma chave ou token de depuração.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false
# Exige token válido na API de sessão. Ative após configurar a chave e testar.
FIREBASE_APPCHECK_ENFORCE=false
